{
  "name": "orbit-rush",
  "version": "1.0.0",
  "description": "Orbit Rush - one-tap endless orbit game. Android-first HTML5 game wrapped with Capacitor.",
  "private": true,
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor-community/admob": "7.2.0",
    "@capacitor-community/keep-awake": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "http-server": "^14.1.1"
  }
}
